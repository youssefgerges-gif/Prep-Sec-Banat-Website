# Supabase Configuration (Optional - standard fallback mock mode runs automatically if omitted)
# ⚠️ ده مشروع Supabase منفصل خالص عن نسخة مدارس الأحد الأساسي — حط هنا
# بيانات مشروع Supabase الجديد بتاع "خدمة مدارس أحد إعدادي وثانوي بنات"،
# مش نفس بيانات المشروع التاني أبدًا.
VITE_SUPABASE_URL=https://your-new-banat-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-new-banat-project-anon-key

# إشعارات الموبايل (اختياري) — المفتاح العام (Public Key) من
# npx web-push generate-vapid-keys . المفتاح الخاص يتحط في Supabase بس، مش هنا.
VITE_VAPID_PUBLIC_KEY=

# وضع التجربة (من غير داتابيز — البيانات بتتحفظ في المتصفح بس). سيبه فاضي
# أو false في الاستخدام العادي.
# VITE_MOCK_MODE=true
